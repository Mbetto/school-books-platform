# Environment variables for the School Books Platform

# Application settings
APP_NAME=SchoolBooksPlatform
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_books
DB_USERNAME=root
DB_PASSWORD=

# Mail configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Other configurations
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file